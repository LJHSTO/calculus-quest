  "post": {
    "id": "EXT-02-post-q4",
    "type": "single",
    "question": "在平面直角坐标系中，某变换 A 把点 (1,0) 移至 (2,5)，把点 (0,1) 移至 (4,1)。另有变换 B 使任意点 (x,y) 变为 (y,x)。如果先执行 B 再执行 A，那么描述这一复合过程的矩阵应表示为？",
    "options": [
      {
        "value": "A",
        "label": "[[5, 1], [2, 4]]"
      },
      {
        "value": "B",
        "label": "[[2, 4], [5, 1]]"
      },
      {
        "value": "C",
        "label": "[[4, 2], [1, 5]]"
      },
      {
        "value": "D",
        "label": "[[4, 1], [2, 5]]"
      }
    ],
    "answer": [
      "C"
