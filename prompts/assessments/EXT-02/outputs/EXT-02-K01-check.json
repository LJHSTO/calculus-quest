          "id": "EXT-02-K01-check-q1",
          "type": "single",
          "question": "已知向量 v = (3, 4)，则向量 2v = (6, 8) 相对于 v 的几何关系是？",
          "options": [
            {
              "value": "A",
              "label": "方向相同，长度是 v 的 2 倍"
            },
            {
              "value": "B",
              "label": "方向相反，长度是 v 的 2 倍"
            },
            {
              "value": "C",
              "label": "方向相同，长度不变"
            },
            {
              "value": "D",
              "label": "方向垂直于 v"
            }
          ],
          "answer": [
            "A"
          ],
          "analysis": "标量乘法 2v 保持向量方向不变，将长度缩放为原来的 2 倍。v 的长度为 √(3²+4²)=5，2v 的长度为 √(6²+8²)=10，方向一致。",
          "points": 10,
          "knowledgePointIds": [
            "EXT-02-K01"
          ],
          "cognitiveLevel": "understanding",
          "estimatedSteps": 2,
          "pairId": "EXT-02-K01-check-pair",
