        {
          "id": "EXT-02-K02-check-q1",
          "type": "single",
          "question": "在平面直角坐标系中，向量 v = (1, 0) 经过矩阵 A = [[0, 1], [1, 0]] 对应的线性变换后，得到的新向量坐标是什么？",
          "options": [
            {
              "value": "A",
              "label": "(0, 1)"
            },
            {
              "value": "B",
              "label": "(1, 1)"
            },
            {
              "value": "C",
              "label": "(0, 0)"
            },
            {
              "value": "D",
              "label": "(1, 0)"
            }
          ],
          "answer": [
            "A"
          ],
          "analysis": "矩阵 A 作用于向量 v 相当于计算 A 与列向量 (1, 0)^T 的乘积。计算过程为 [[0, 1], [1, 0]] * (1, 0)^T = (0*1 + 1*0, 1*1 + 0*0)^T = (0, 1)^T。从几何意义上看，该变换将 x 轴上的单位向量映射到了 y 轴上，体现了矩阵运算与线性变换之间的直接联系。",
          "points": 10,
          "knowledgePointIds": [
            "EXT-02-K02"
          ],
          "cognitiveLevel": "apply",
          "estimatedSteps": 2,
          "pairId": "EXT-02-K02-check",
          "adaptiveRole": "core",
          "equivalence": {
            "presentationMode": "text",
            "knownConditionCount": 2,
