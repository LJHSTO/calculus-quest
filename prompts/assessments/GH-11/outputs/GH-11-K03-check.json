          "options": [
            {
              "value": "A",
              "label": "Hessian 矩阵是一个由二阶偏导数组成的方阵"
            },
            {
              "value": "B",
              "label": "Hessian 矩阵可以用来反映函数图像在局部的凹凸性质"
            },
            {
              "value": "C",
              "label": "Hessian 矩阵就是函数梯度的雅可比矩阵"
            },
            {
              "value": "D",
              "label": "只要写出了 Hessian 矩阵的符号形式，就等于完成了对该矩阵实际作用的完整分析"
