      "keyPoints": [
        {
          "id": "GH-12-K01-check-q1",
          "type": "single",
          "question": "在无约束优化中，我们将目标函数 f(x) 的函数值视为一种“地形”。若仅根据目标函数地形的核心含义，以下哪种描述是准确的？",
          "options": [
            {
              "value": "A",
              "label": "目标函数地形是指自变量 x 的取值范围大小，范围越大则地形越陡峭。"
            },
            {
              "value": "B",
              "label": "目标函数地形是指目标函数 f(x) 在不同自变量取值下的高低起伏形态，反映了函数值的变化规律。"
            },
            {
              "value": "C",
              "label": "目标函数地形是指函数图像在二维坐标系中与坐标轴围成的面积大小。"
            },
            {
              "value": "D",
              "label": "目标函数地形是指函数导数的符号，导数为正即为上坡，导数为零即为平地，与其他因素无关。"
            }
          ],
          "answer": [
            "B"
          ],
          "analysis": "目标函数地形的核心含义是将目标函数 f(x) 的函数值大小类比为地理上的海拔高度，从而把函数在不同自变量处的变化情况直观地理解为地形的起伏。选项 A 错误，地形描述的是函数值的起伏形态而非自变量的取值范围；选项 C 错误，地形不是指面积；选项 D 错误，虽然导数能反映局部变化趋势，但目标函数地形是整体的直观形态概念，不能仅归结为导数的符号。因此选项 B 正确。",
          "points": 10,
          "knowledgePointIds": [
            "GH-12-K01"
          ],
          "cognitiveLevel": "understand",
          "estimatedSteps": 2,
          "pairId": "GH-12-K01-check-pair",
          "adaptiveRole": "core",
