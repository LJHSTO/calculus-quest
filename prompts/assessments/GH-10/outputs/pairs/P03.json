{
  "pre": {
    "id": "GH-10-pre-q3",
    "type": "single",
    "question": "已知函数 z=f(x,y) 通过中间变量 x=u^2 和 y=v+1 由 u,v 决定。若在 u=2, v=1 时，偏导数 ∂z/∂x=3 且 ∂z/∂y=5，根据多元链式法则，此时复合函数 z 对 u 的偏导数是多少？",
    "options": [
      {
        "value": "A",
        "label": "∂z/∂u = 3 × 2 + 5 × 1 = 11"
      },
      {
        "value": "B",
        "label": "∂z/∂u = 3 × 4 + 5 × 2 = 22"
      },
      {
        "value": "C",
        "label": "∂z/∂u = 3 × 4 + 5 × 0 = 12"
      },
      {
        "value": "D",
        "label": "∂z/∂u = 3 × 4 + 5 × 1 = 17"
      }
    ],
    "answer": [
      "C"
    ],
    "analysis": "根据多元链式法则，∂z/∂u=(∂z/∂x)(∂x/∂u)+(∂z/∂y)(∂y/∂u)。由 x=u² 得 ∂x/∂u=2u=4，由 y=v+1 得 ∂y/∂u=0。代入得 3×4+5×0=12，因此选 C。",
    "points": 8,
    "knowledgePointIds": [
      "GH-10-K01"
    ],
    "cognitiveLevel": "apply",
    "estimatedSteps": 3,
    "pairId": "P03",
