# Mac 本机开发预览；只监听本机，模型使用模拟响应。
# 该配置创建全新的开发数据库，不包含 Windows 的账号和学习记录。
NODE_ENV=development
HOST=127.0.0.1
PORT=8765
BASE_PATH=
DB_PATH=data/mac-r13-development.db
LOCAL_ADMIN_AUTH_BYPASS=true
LLM_PROVIDER=mock
GRADING_LLM_PROVIDER=mock
ASSESSMENT_LLM_ENABLED=false
COACH_NARRATION_LLM_ENABLED=false
PROACTIVE_POLICY_MODE=active
PROACTIVE_EXPERIMENT_CHAPTER_ID=V14-C1
PROACTIVE_EXPERIMENT_ID=mac-r13-development-20261111
PROACTIVE_ADAPTER_VERSION=functions-limits-adapter-r13
PROACTIVE_OUTCOME_INSTRUMENT_VERSION=functions-limits-delayed-r12-20261108
# 公开的本地模拟标记，不用于正式研究分配。
PROACTIVE_ASSIGNMENT_SALT=mac-local-development-only
PROACTIVE_PARTICIPATION_MODE=implicit-pilot
PROACTIVE_PUBLIC_CHAPTER_ONLY=true
PROACTIVE_EXPERIMENT_ARMS=treatment_full
PROACTIVE_DISPLAY_ARMS=treatment_full
RESEARCH_CONTROLS_ENABLED=true
RESEARCH_CONTROLS_DEMO=true
LEARNER_ONBOARDING_REQUIRED=false
RATE_LIMIT_MAX=2000
