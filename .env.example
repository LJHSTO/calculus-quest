## Copy this file to .env and fill in values for your own environment.
## Do not commit real API keys or passwords.

# Server
HOST=127.0.0.1
PORT=8765

# Optional OpenAI-compatible model configuration for short-answer grading.
# Leave LLM_PROVIDER=mock to disable real model calls; short answers fall back to 0 points with review required.
LLM_PROVIDER=mock
# LLM_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
# OPENAI_COMPATIBLE_API_KEY=replace-with-your-key
# OPENAI_COMPATIBLE_MODEL=replace-with-your-model
# GRADING_MODEL=replace-with-your-model
# ASSESSMENT_MODEL=replace-with-your-model

# Optional admin password for the learning analytics dashboard.
# ADMIN_TOKEN=replace-with-a-strong-password
