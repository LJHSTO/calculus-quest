## Copy this file to .env and fill in values for your own environment.
## Do not commit real API keys or passwords.

# Server
HOST=127.0.0.1
PORT=8765
NODE_ENV=development

# Public reverse-proxy prefix. Use the public path without a trailing slash.
# The server accepts both prefix-preserving and prefix-stripping Nginx proxy_pass modes.
# BASE_PATH=/calculus_quest

# Production must use an existing absolute DB_PATH outside the Git repository.
# Windows example: D:\CalculusQuestData\calculus-quest.db
# Linux example: /srv/calculus-quest-data/calculus-quest.db
# DB_PATH=/srv/calculus-quest-data/calculus-quest.db

# Release and research labels stored with new interaction events.
APP_VERSION=2.0.0
# EXPERIMENT_ID=calculus-quest-2026
# EXPERIMENT_CONDITION=agentic-choice
# EXPERIMENT_COHORT=fall-2026-a

# 函数与极限主动 Agent 试点。默认 shadow：记录政策判断但不向学生展示。
PROACTIVE_POLICY_MODE=shadow
# 中文教材与18题保持测修订须使用新实验 ID，不复用已冻结的旧协议。
PROACTIVE_EXPERIMENT_ID=functions-limits-standalone-20260918
PROACTIVE_EXPERIMENT_CHAPTER_ID=V14-C1
PROACTIVE_POLICY_VERSION=v14-c3-fixed-v3
PROACTIVE_CONTRACT_VERSION=proactive-learning-contract-v1
PROACTIVE_ADAPTER_VERSION=functions-limits-adapter-r2
PROACTIVE_OUTCOME_INSTRUMENT_VERSION=functions-limits-retention-r3
PROACTIVE_ASSIGNMENT_STRATEGY=hash
PROACTIVE_ASSIGNMENT_VERSION=student-hash-v1
# 小样本可在正式招募前改为 stratified-balanced，并使用新的实验 ID 与 assignment version。
# 同一实验 ID 已产生协议快照后，不能切换分配策略或重新分组。
# PROACTIVE_ASSIGNMENT_STRATEGY=stratified-balanced
# PROACTIVE_ASSIGNMENT_VERSION=stratified-balanced-v1
# 在创建任何实验分组前，必须设置稳定且不公开的分组盐；active 缺失时失败关闭。
# PROACTIVE_ASSIGNMENT_SALT=replace-with-a-stable-private-study-salt
PROACTIVE_EXPERIMENT_COHORT=pilot
PROACTIVE_PUBLIC_CHAPTER_ONLY=true
# implicit-pilot 只用于工程联调，会自动记录工程试点参与；正式研究应改为 explicit-consent。
PROACTIVE_PARTICIPATION_MODE=implicit-pilot
PROACTIVE_CONSENT_VERSION=engineering-pilot-v1
# 正式研究示例：
# PROACTIVE_PARTICIPATION_MODE=explicit-consent
# PROACTIVE_CONSENT_VERSION=functions-limits-consent-v1
# PROACTIVE_CONSENT_NOTICE_URL=/approved-study-notice
# 两组内部试跑示例：共同保留按需问答，仅完整主动政策的展示权限不同。
PROACTIVE_EXPERIMENT_ARMS=control,treatment_full
PROACTIVE_DISPLAY_ARMS=treatment_full
# 正式 Pilot 默认锁定全局提醒方案；学生只能对单个知识点稍后、换帮助、关闭或恢复提醒。
PROACTIVE_GLOBAL_PREFERENCE_CONTROL=false
# 完整主动组最高允许 L5；不是每次直接展示 L5。
# JSON 必须保持单行。生产环境还应替换实验编号、私有盐值与仓库外 DB_PATH。
PROACTIVE_ARM_PROFILES_JSON={"control":{"display":false,"maxSupportLevel":"L0","allowRepresentationSwitch":false},"treatment_full":{"display":true,"maxSupportLevel":"L5","allowRepresentationSwitch":true}}
# 章后测完成 72 小时后开放延迟保持测。
PROACTIVE_RETENTION_DELAY_HOURS=72
# 0 表示满72小时开放后不设截止时间；72、96小时节点仍写入提醒状态。
# 改变冻结批次的时间政策须使用新实验编号；不覆盖历史会话。
PROACTIVE_RETENTION_CLOSE_HOURS=0
PROACTIVE_RETENTION_REMINDER_HOURS=72,96
# PROACTIVE_HELP_NEED_THRESHOLD=0.70
# PROACTIVE_INTERRUPTIBILITY_THRESHOLD=0.75
# PROACTIVE_UNCERTAINTY_THRESHOLD=0.30
# PROACTIVE_DECISION_TTL_MS=900000

# 可选的 OpenAI-compatible 模型配置，供知点、Coach、诊断和简答评分共同使用。
# 保持 LLM_PROVIDER=mock 可禁用真实模型调用，确定性兜底仍然可用。
LLM_PROVIDER=mock
# LLM_PROVIDER=openai-compatible
# 推荐：文件可包含纯密钥、KEY=value、JSON，或供应商给出的 curl 示例。
# 文件仅在服务端运行时读取，不要把密钥复制到仓库或 .env。
# LLM_CONFIG_FILE=D:\Desktop\key.txt
# OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
# OPENAI_COMPATIBLE_API_KEY=replace-with-your-key
# OPENAI_COMPATIBLE_MODEL=replace-with-your-model
# OPENAI_COMPATIBLE_WIRE_API=chat-completions
# LEARNING_ASSISTANT_MODEL=replace-with-your-fast-chat-model
# COACH_NARRATION_MODEL=replace-with-your-fast-chat-model
# GRADING_MODEL=replace-with-your-model
# ASSESSMENT_MODEL=replace-with-your-model
# ASSESSMENT_LLM_ENABLED=false
COACH_NARRATION_LLM_ENABLED=false
# Maximum simultaneous model grading calls per server process.
GRADING_CONCURRENCY=4

# Local redacted error records; Sentry is optional and stays server-side.
ERROR_MONITORING_ENABLED=true
# ERROR_MONITORING_PATH=/absolute/private/data/error-monitoring.json
# SENTRY_DSN=
# ASSESSMENT_TIMEOUT_MS=12000
# COACH_NARRATION_TIMEOUT_MS=12000
#
# SiliconFlow example:
# OPENAI_COMPATIBLE_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_COMPATIBLE_MODEL=zai-org/GLM-5.2
# LEARNING_ASSISTANT_MODEL=zai-org/GLM-4.5-Air
#
# Responses API 示例。凭据应由服务端环境或 LLM_CONFIG_FILE 提供；
# 应用代码不得读取 Codex 桌面的认证文件。
# OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
# OPENAI_COMPATIBLE_WIRE_API=responses
# OPENAI_COMPATIBLE_MODEL=replace-with-your-responses-model
#
# OpenAI-compatible auto-routing example for historical short-answer regrading.
# These grading-only variables keep the learning assistant on its existing provider.
# GRADING_LLM_PROVIDER=openai-compatible
# GRADING_BASE_URL=https://api.example.com/v1
# GRADING_API_KEY=replace-with-your-private-key
# GRADING_CONFIG_FILE=D:\path\to\grading-key.txt
# GRADING_WIRE_API=chat-completions
# GRADING_MODEL=auto
# GRADING_TIMEOUT_MS=120000

# 本机回环地址默认免登录；设为 false 可强制本机也验证 Token。
# LOCAL_ADMIN_AUTH_BYPASS=false
# Optional admin password for remote access to the learning analytics dashboard.
# ADMIN_TOKEN=replace-with-a-strong-password
# 知点：学生主动提问额度与后台教学策略判断预算互相独立。
LEARNING_ASSISTANT_DAILY_QUOTA=30
LEARNING_ASSISTANT_DAILY_INTERVENTIONS=10
