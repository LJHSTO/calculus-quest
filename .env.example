# Copy this file to .env and configure your server.
# Keep credentials in the server environment or a private configuration file.

# HTTP server
HOST=127.0.0.1
PORT=8765
NODE_ENV=development
# Public URL prefix for reverse-proxy deployments, without a trailing slash.
# BASE_PATH=/calculus_quest
# In production, use an existing absolute database path outside the repository.
# DB_PATH=/srv/calculus-quest-data/calculus-quest.db

# Version and study labels included in interaction records.
APP_VERSION=2.0.0
# EXPERIMENT_ID=calculus-quest-2026
# EXPERIMENT_CONDITION=agentic-choice
# EXPERIMENT_COHORT=fall-2026-a

# General proactive policy: off, shadow (record decisions), or active (show help).
PROACTIVE_POLICY_MODE=shadow
PROACTIVE_EXPERIMENT_ID=functions-limits-kp-crossover-r6-20260922
PROACTIVE_EXPERIMENT_CHAPTER_ID=V14-C1
PROACTIVE_POLICY_VERSION=v14-c3-fixed-v3
PROACTIVE_CONTRACT_VERSION=proactive-learning-contract-v1
PROACTIVE_ADAPTER_VERSION=functions-limits-adapter-r16
PROACTIVE_OUTCOME_INSTRUMENT_VERSION=functions-limits-retention-r4
# Optional configuration for separately hosted studies.
RESEARCH_SITES_CONFIG_FILE=

# Assignment: hash or stratified-balanced. Keep the salt stable for each study.
PROACTIVE_ASSIGNMENT_STRATEGY=hash
PROACTIVE_ASSIGNMENT_VERSION=student-hash-v1
# PROACTIVE_ASSIGNMENT_SALT=replace-with-a-stable-private-study-salt
PROACTIVE_EXPERIMENT_COHORT=pilot
PROACTIVE_PUBLIC_CHAPTER_ONLY=true
# Participation: implicit-pilot or explicit-consent.
PROACTIVE_PARTICIPATION_MODE=implicit-pilot
PROACTIVE_CONSENT_VERSION=engineering-pilot-v1
# PROACTIVE_CONSENT_NOTICE_URL=/study-notice

# General policy arms and their maximum support levels.
# The A/B/C study flow is configured separately in the administration panel.
PROACTIVE_EXPERIMENT_ARMS=control,treatment_full
PROACTIVE_DISPLAY_ARMS=treatment_full
PROACTIVE_GLOBAL_PREFERENCE_CONTROL=false
# Keep JSON on one line.
PROACTIVE_ARM_PROFILES_JSON={"control":{"display":false,"maxSupportLevel":"L0","allowRepresentationSwitch":false},"treatment_full":{"display":true,"maxSupportLevel":"L5","allowRepresentationSwitch":true}}

# Delayed assessment opens this many hours after the post-test.
PROACTIVE_RETENTION_DELAY_HOURS=72
# Zero leaves the assessment open without an end time.
PROACTIVE_RETENTION_CLOSE_HOURS=0
PROACTIVE_RETENTION_REMINDER_HOURS=72,96
# PROACTIVE_HELP_NEED_THRESHOLD=0.70
# PROACTIVE_INTERRUPTIBILITY_THRESHOLD=0.75
# PROACTIVE_UNCERTAINTY_THRESHOLD=0.30
# PROACTIVE_DECISION_TTL_MS=900000

# Model service shared by the learning assistant and other model-enabled features.
# mock uses local responses; openai-compatible connects to a model provider.
LLM_PROVIDER=mock
# LLM_PROVIDER=openai-compatible
# LLM_CONFIG_FILE=/path/to/private/model.env
# OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
# OPENAI_COMPATIBLE_API_KEY=replace-with-your-key
# OPENAI_COMPATIBLE_MODEL=replace-with-your-model
# OPENAI_COMPATIBLE_WIRE_API=chat-completions
# Use responses above for a provider exposing the Responses API.
# Set only if the provider supports enable_thinking; shared by all study arms.
# OPENAI_COMPATIBLE_ENABLE_THINKING=false
# Use the same model and generation settings across A/B/C.
# ASSESSMENT_LLM_ENABLED=false
# ASSESSMENT_TIMEOUT_MS=12000
COACH_NARRATION_LLM_ENABLED=false
# COACH_NARRATION_TIMEOUT_MS=12000
GRADING_CONCURRENCY=4

# Error records are redacted; optional Sentry reporting runs on the server.
ERROR_MONITORING_ENABLED=true
# ERROR_MONITORING_PATH=/path/to/private/error-monitoring.json
# SENTRY_DSN=

# Set false to require the admin password even on loopback connections.
# LOCAL_ADMIN_AUTH_BYPASS=false
# ADMIN_TOKEN=replace-with-a-strong-password

# Per-student daily budgets for requested dialogue and proactive interventions.
LEARNING_ASSISTANT_DAILY_QUOTA=120
LEARNING_ASSISTANT_DAILY_INTERVENTIONS=24
# Shared FIFO queue per server process. Model execution timing starts after dequeue.
LLM_MAX_CONCURRENT=24
LLM_MAX_PENDING=128
LLM_QUEUE_TIMEOUT_MS=90000

# Optional configuration controls in the research workspace.
RESEARCH_CONTROLS_ENABLED=false
RESEARCH_CONTROLS_DEMO=false

# Optional protocol for the common-probe learning flow.
# MAIN_LEARNING_PROTOCOL_FILE=/path/to/private/study-protocol.json
# PROACTIVE_STUDY_SEED=replace-with-a-private-random-seed
# PROACTIVE_STUDY_ASSIGNMENT_MODE=participant-blocks
