## Copy to .env and fill in your Pioneer (OpenAI-compatible) credentials.
## The grading/assessment/coach agents fall back to a local mock when LLM_PROVIDER is unset,
## which keeps short-answer grading as pending review. Set LLM_PROVIDER=pioneer to grade for real.

LLM_PROVIDER=pioneer
PIONEER_API_KEY=your-key-here
# PIONEER_BASE_URL=https://api.pioneer.ai/v1
# PIONEER_MODEL=pioneer/auto
# GRADING_MODEL=pioneer/auto
# ASSESSMENT_MODEL=pioneer/auto
# ADMIN_TOKEN=your-admin-token
